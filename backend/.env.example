# Postgres externo (o projeto não sobe banco próprio)
DATABASE_URL=postgres://usuario:senha@host:porta/banco?sslmode=disable
PORT=6802
FRONTEND_URL=http://localhost:6803
BETTER_AUTH_SECRET=change-this-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:6802

# worker-whatsapp (conexão WhatsApp, histórico e mídia)
WORKER_URL=http://localhost:6801
# Mesmo valor de WORKER_API_KEY no worker-whatsapp/.env
WORKER_API_KEY=
# Mesmo valor de BACKEND_WEBHOOK_SECRET no worker-whatsapp/.env
WORKER_WEBHOOK_SECRET=
RABBITMQ_URL=
RABBITMQ_QUEUE_PREFIX=whatsapp

# Agentes de IA
# Chave usada para criptografar os tokens (OpenAI/ADK) dos agentes no banco. NÃO troque depois de criar agentes.
AGENT_TOKENS_SECRET=

# S3 (documentos do RAG enviados na tela de agentes)
SEAWEEDFS_S3_ENDPOINT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_S3_BUCKET=
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_PREFIX=

# Chave das rotas internas (/api/internal), usada pelo worker-whatsapp e pelo AI-Worker
INTERNAL_API_KEY=
# Valor inicial de agentActive para contatos novos (true = o agente de IA atende)
DEFAULT_AGENT_ACTIVE=true
