# Porta do healthcheck (sequência do projeto: worker 6801, backend 6802, frontend 6803, AI-Worker 6804)
PORT=6804

# Mesmo RabbitMQ do backend e do worker-whatsapp
URL_RABBITMQ=
WHATSAPP_QUEUE_PREFIX=whatsapp

# Sessões (histórico das conversas). Formato do psycopg: postgresql://usuario:senha@host:porta/banco
URL_SESSIONS=

# pgvector (RAG)
URL_PGVECTOR=
PGVECTOR_COLLECTION=sturnus_flows_agents

# OpenAI: modelo de chat e embeddings. A chave é o fallback quando o agente não tem tokenOpenAi na plataforma.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.3
AGENT_TIMEZONE="America/Sao_Paulo"

AI_CONCURRENCY=4
AI_SESSION_TTL_HOURS=24
# Mensagens anteriores (contato + agente) enviadas ao modelo junto com a atual. 0 = sem limite.
AI_HISTORY_MESSAGES=4
# Passos máximos do grafo por resposta (cada ida ao modelo ou às ferramentas conta um).
AI_MAX_STEPS=12
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Trechos da base de conhecimento devolvidos por busca.
RAG_TOP_K=4

# Backend (grava os metadados coletados nos extras do contato). Mesmo valor de INTERNAL_API_KEY no backend.
BACKEND_URL=http://localhost:6802
BACKEND_INTERNAL_API_KEY=

# S3 (baixar os documentos enviados pela tela de agentes)
SEAWEEDFS_S3_ENDPOINT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_S3_BUCKET=
SEAWEEDFS_S3_REGION=us-east-1
