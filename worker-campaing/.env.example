PORT=6805
NODE_ENV=development
# Mesmo Postgres e RabbitMQ do backend (backend/.env)
DATABASE_URL=postgresql://user:password@host:5432/db
RABBITMQ_URL=amqp://user:password@host:5672
RABBITMQ_QUEUE_PREFIX=whatsapp
# Disparo em lotes
CAMPAIGN_SCHEDULER_INTERVAL_MS=30000
CAMPAIGN_SCHEDULER_MAX_CONCURRENT=5
# Pausa entre mensagens dentro de um lote (reduz risco de bloqueio do número)
CAMPAIGN_SEND_DELAY_MS=1000
