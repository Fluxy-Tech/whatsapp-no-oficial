# Aplicação
PORT=6801
NODE_ENV=development
# Chave exigida no header "x-api-key" de todas as rotas /api
WORKER_API_KEY=troque-por-uma-chave-longa
# Pasta onde o wppconnect guarda os tokens das sessões (não precisa ler QR de novo)
WPP_TOKENS_FOLDER=tokens
PUPPETEER_EXECUTABLE_PATH=

# Webhook do backend (recebe as notificações do worker)
BACKEND_WEBHOOK_URL=http://localhost:6802/api/webhooks/whatsapp
# Usado para assinar o corpo do webhook (header "x-worker-signature" = HMAC-SHA256 hex)
BACKEND_WEBHOOK_SECRET=troque-por-um-segredo-longo
BACKEND_WEBHOOK_TIMEOUT_MS=10000
# Rotas internas do backend (sessões para restaurar). Mesmo valor de INTERNAL_API_KEY no backend.
# BACKEND_URL é opcional: por padrão usa a origem do BACKEND_WEBHOOK_URL.
BACKEND_INTERNAL_API_KEY=

# Mídia (S3 / SeaweedFS)
SEAWEEDFS_S3_ENDPOINT=
SEAWEEDFS_S3_ACCESS_KEY=
SEAWEEDFS_S3_SECRET_KEY=
SEAWEEDFS_S3_BUCKET=
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_PREFIX=fluxy-saas/worker-whatsapp
# Validade (segundos) das URLs assinadas de mídia enviadas no webhook
S3_PRESIGNED_URL_TTL=3600

# Mongo
MONGO_URL=
MONGO_DB_NAME=

# Mensageria
RABBITMQ_URL=
# Prefixo das filas: <prefix>.inbound | <prefix>.outbound | <prefix>.webhook
RABBITMQ_QUEUE_PREFIX=whatsapp
RABBITMQ_PREFETCH=10
# Tentativas antes de mandar a mensagem para a DLQ, e o atraso entre elas
RABBITMQ_MAX_ATTEMPTS=5
RABBITMQ_RETRY_DELAY_MS=10000

